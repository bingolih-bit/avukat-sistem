# MongoDB Connection String
# Get this from MongoDB Atlas (Free tier: https://www.mongodb.com/cloud/atlas/register)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/avukat-sistem?retryWrites=true&w=majority

# Server Port
PORT=3001

# CORS Origin (Frontend URL)
FRONTEND_URL=http://localhost:3000

# VAPID Keys for Push Notifications
# Generate with: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=your_public_key_here
VAPID_PRIVATE_KEY=your_private_key_here

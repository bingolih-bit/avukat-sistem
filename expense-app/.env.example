# ===========================================
# HARCAMA-GELİR TAKİP SİSTEMİ - ENVIRONMENT VARIABLES
# ===========================================

# ---------------------------------------------
# DATABASE (PostgreSQL - Render.com)
# ---------------------------------------------
# Render.com'dan PostgreSQL database oluşturun
# Dashboard → New → PostgreSQL
# External Database URL'yi kopyalayın
DATABASE_URL="postgresql://user:password@hostname:5432/database"

# Örnek:
# DATABASE_URL="postgresql://expense_user:abc123@dpg-xxxxx.oregon-postgres.render.com:5432/expense_db"

# ---------------------------------------------
# NEXTAUTH (Authentication)
# ---------------------------------------------
# NextAuth için secret key (rastgele bir string)
# Terminal'de oluşturmak için: openssl rand -base64 32
NEXTAUTH_SECRET="buraya-random-secret-key-yazin"

# Production URL (Vercel'e deploy edince otomatik dolar)
NEXTAUTH_URL="http://localhost:3000"

# Production'da:
# NEXTAUTH_URL="https://expense-tracker.vercel.app"

# ---------------------------------------------
# EMAIL (Hatırlatmalar için - Opsiyonel)
# ---------------------------------------------
# Gmail SMTP kullanacaksanız:
# 1. Google Hesap → Güvenlik → 2 Adımlı Doğrulama → Uygulama şifreleri
# 2. Uygulama şifresi oluşturun

EMAIL_FROM="your-email@gmail.com"
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="uygulama-sifresi"

# ---------------------------------------------
# FILE UPLOAD (Fiş/Fatura Fotoğrafları)
# ---------------------------------------------
# Cloudinary (Ücretsiz 25GB/ay)
# https://cloudinary.com/users/register_free

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Alternatif: Uploadthing (10GB/ay ücretsiz)
# UPLOADTHING_SECRET="sk_live_..."
# UPLOADTHING_APP_ID="app_..."

# ---------------------------------------------
# APP CONFIG
# ---------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production'da:
# NEXT_PUBLIC_APP_URL="https://expense-tracker.vercel.app"

# ---------------------------------------------
# KURULUM ADIMLARI
# ---------------------------------------------
# 1. Bu dosyayı .env.local olarak kopyalayın:
#    cp .env.example .env.local
#
# 2. Yukarıdaki değerleri doldurun
#
# 3. Prisma migration çalıştırın:
#    npx prisma migrate dev
#    npx prisma db seed
#
# 4. Development başlatın:
#    npm run dev
#
# 5. Tarayıcıda açın:
#    http://localhost:3000
